---
import Layout from '../components/Layout.astro';

const companyInfo: { title: string; details: { label: string; value: string; link?: string }[] }[] = [
	{
		title: 'Company Information',
		details: [
			{ label: 'Name', value: 'Shironeko Digital OÜ' },
			{ label: 'Address', value: 'Sepapaja tn 6' },
			{ label: 'Location', value: '15551 Tallinn, Estonia' },
		],
	},
	{
		title: 'Contact',
		details: [
			{ label: 'Email', value: 'hello@shironekodigital.com', link: 'mailto:hello@shironekodigital.com' },
			{ label: 'Website', value: 'shironekodigital.com', link: '/' },
		],
	},
	{
		title: 'Registry Information',
		details: [
			{ label: 'Registry Code', value: '17395577' },
			{ label: 'Jurisdiction', value: 'Registered in Estonia' },
		],
	},
];
---

<Layout title="Company" description="Legal information and contact details for Shironeko Digital OÜ.">
	<section class="pt-24 md:pt-28 pb-12 md:pb-16 bg-white border-b border-zinc-200">
		<div class="max-w-7xl mx-auto px-6 md:px-12">
			<div class="flex flex-col lg:flex-row lg:justify-between lg:items-start gap-10 lg:gap-14">
				<div class="min-w-0 space-y-4 lg:max-w-2xl">
					<p class="font-mono-ui text-[11px] text-zinc-500 tracking-[0.28em] uppercase" data-reveal="fade">
						Company
					</p>
					<h1
						class="font-display text-4xl md:text-[46px] text-zinc-950 leading-[1.05] tracking-tight"
						data-reveal="up"
						data-reveal-delay="0.06"
					>
						Legal details, plainly listed.
					</h1>
					<p class="text-zinc-600 text-base leading-relaxed max-w-xl" data-reveal="up" data-reveal-delay="0.12">
						Everything you need for invoices, contracts, and due diligence—without hunting through footer links.
					</p>
				</div>
				<figure class="hidden lg:block shrink-0 w-80 min-h-[280px] max-h-[320px] border border-zinc-200 overflow-hidden bg-zinc-100 m-0">
					<img
						src="/images/sidebar-macbook-code.jpg"
						alt=""
						class="size-full min-h-[280px] object-cover object-[35%_center]"
						width="960"
						height="840"
						loading="lazy"
						decoding="async"
					/>
				</figure>
			</div>
		</div>
	</section>

	<section class="bg-white">
		<div class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-20">
			<div class="flex flex-row justify-between items-end gap-8 pb-8 md:pb-12 border-b border-zinc-200">
				<div class="space-y-3 min-w-0">
					<p class="font-mono-ui text-[11px] text-zinc-500 tracking-[0.28em] uppercase" data-reveal="fade">
						Registration
					</p>
					<h2 class="font-display text-3xl md:text-[34px] text-zinc-950 tracking-tight" data-reveal="up" data-reveal-delay="0.06">
						Name, seat, and contacts
					</h2>
				</div>
				<div class="hidden sm:block w-px h-24 bg-zinc-200 shrink-0" aria-hidden="true"></div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 pt-10 md:pt-12">
				{
					companyInfo.map((info, i) => (
						<div
							class="flex flex-col border border-zinc-200 bg-zinc-50/40 px-6 py-8 md:px-8 md:py-10"
							data-reveal="up"
							data-reveal-delay={String(Math.min(i * 0.08, 0.24))}
						>
							<h3 class="font-mono-ui text-[11px] text-zinc-500 tracking-[0.28em] uppercase mb-8 pb-4 border-b border-zinc-200">
								{info.title}
							</h3>
							<div class="space-y-6">
								{info.details.map((detail) => (
									<div>
										<p class="font-mono-ui text-[10px] tracking-[0.2em] uppercase text-zinc-400 mb-1.5">
											{detail.label}
										</p>
										{detail.link ? (
											<a
												href={detail.link}
												class="text-[15px] font-medium text-zinc-950 hover:underline underline-offset-4 decoration-zinc-300"
											>
												{detail.value}
											</a>
										) : (
											<p class="text-[15px] font-medium text-zinc-950 leading-snug">{detail.value}</p>
										)}
									</div>
								))}
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-zinc-100 border-y border-zinc-200">
		<div class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-20">
			<div class="flex flex-col md:flex-row gap-12 md:gap-14 items-start">
				<div class="shrink-0 space-y-5 w-full md:w-55">
					<p class="font-mono-ui text-[11px] text-zinc-500 tracking-[0.28em] uppercase" data-reveal="right" data-reveal-duration="0.75">
						Disclaimer
					</p>
					<p
						class="font-display text-[5rem] md:text-[6rem] leading-[0.75] text-zinc-200 select-none"
						data-reveal="fade"
						data-reveal-delay="0.1"
						data-reveal-duration="1"
						aria-hidden="true"
					>
						—
					</p>
				</div>
				<div class="min-w-0 space-y-5 md:pt-1 max-w-3xl">
					<h2 class="font-display text-3xl md:text-[44px] text-zinc-950 leading-[1.06] tracking-tight" data-reveal="up" data-reveal-delay="0.06">
						Legal disclaimer
					</h2>
					<div class="space-y-5 text-zinc-600 text-[15px] leading-[1.55]">
						<p data-reveal="up" data-reveal-delay="0.1">
							The information provided on this website is for general informational purposes only. While we strive to
							keep the information up to date and correct, we make no representations or warranties of any kind, express
							or implied, about the completeness, accuracy, reliability, suitability, or availability with respect to the
							website or the information, products, services, or related graphics contained on the website for any
							purpose.
						</p>
						<p data-reveal="up" data-reveal-delay="0.14">
							Any reliance you place on such information is therefore strictly at your own risk. In no event will we be
							liable for any loss or damage including without limitation, indirect or consequential loss or damage, or any
							loss or damage whatsoever arising from loss of data or profits arising out of, or in connection with, the
							use of this website.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-white border-t border-zinc-200">
		<div class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-20">
			<div class="flex flex-col md:flex-row md:justify-between md:items-start gap-10">
				<div class="space-y-4 max-w-xl">
					<p class="font-mono-ui text-[11px] text-zinc-500 tracking-[0.28em] uppercase" data-reveal="fade">Next step</p>
					<p class="text-zinc-950 text-xl md:text-[22px] leading-snug font-medium" data-reveal="up" data-reveal-delay="0.06">
						Questions about engagement or billing details? Reach out directly.
					</p>
				</div>
				<div class="flex flex-col gap-3 shrink-0">
					<div class="w-30 h-px bg-zinc-300" data-reveal="fade" data-reveal-delay="0.1" aria-hidden="true"></div>
					<a
						href="mailto:hello@shironekodigital.com"
						class="font-mono-ui text-xs text-zinc-900 hover:underline underline-offset-4"
						data-reveal="left"
						data-reveal-delay="0.16"
						>hello@shironekodigital.com</a
					>
				</div>
			</div>
		</div>
	</section>
</Layout>
