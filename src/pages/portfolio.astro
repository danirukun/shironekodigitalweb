---
import { createImageUrlBuilder } from '@sanity/image-url';
import { sanityClient } from 'sanity:client';
import Layout from '../components/Layout.astro';
import PortfolioCaseRow from '../components/PortfolioCaseRow.astro';
import { portfolioProjectsQuery } from '../sanity/queries';

const builder = createImageUrlBuilder(sanityClient);

type PortfolioRow = {
	_id: string;
	title: string;
	slug: string;
	description: string;
	tags: string[] | null;
	projectUrl?: string | null;
	image?: unknown;
};

const rows = await sanityClient.fetch<PortfolioRow[]>(portfolioProjectsQuery);

const projects = rows.map((row) => ({
	title: row.title,
	description: row.description,
	tags: row.tags ?? [],
	projectUrl: row.projectUrl ?? undefined,
	image: row.image ? builder.image(row.image).width(1200).url() : undefined,
}));
---

<Layout
	title="Portfolio"
	description="Casefiles: interfaces, infrastructure, and creator-side tools Shironeko Digital has shipped for live and spatial workflows."
>
	<section class="pt-24 md:pt-28 pb-12 md:pb-16 bg-white border-b border-zinc-200">
		<div class="max-w-7xl mx-auto px-6 md:px-12">
			<div class="flex flex-col lg:flex-row lg:justify-between lg:items-start gap-10 lg:gap-14">
				<div class="min-w-0 space-y-4 lg:max-w-2xl">
					<p class="font-mono-ui text-[11px] text-zinc-500 tracking-[0.28em] uppercase" data-reveal="fade">Casefiles</p>
					<h1
						class="font-display text-4xl md:text-[46px] text-zinc-950 leading-[1.05] tracking-tight"
						data-reveal="up"
						data-reveal-delay="0.06"
					>
						Creating software that people love—shown in production.
					</h1>
					<p class="text-zinc-600 text-base leading-relaxed max-w-xl" data-reveal="up" data-reveal-delay="0.12">
						Delivering perfection at every level: the interfaces, services, and creator tools we’ve shipped where
						latency, clarity, and calm under load actually matter.
					</p>
				</div>
				<figure class="hidden lg:block shrink-0 w-80 min-h-[280px] max-h-[320px] border border-zinc-200 overflow-hidden bg-zinc-100 m-0">
					<img
						src="/images/sidebar-macbook-code.jpg"
						alt=""
						class="size-full min-h-[280px] object-cover object-[35%_center]"
						width="960"
						height="840"
						loading="lazy"
						decoding="async"
					/>
				</figure>
			</div>
		</div>
	</section>

	<section class="bg-white">
		<div class="max-w-7xl mx-auto px-6 md:px-12 pb-12">
			{
				projects.map((project, i) => (
					<PortfolioCaseRow {...project} reverse={i % 2 === 1} revealIndex={i} />
				))
			}
			<div class="py-14 md:py-16 border-t border-zinc-200 mt-2">
				<p class="font-mono-ui text-[11px] text-zinc-500 tracking-[0.28em] uppercase mb-3" data-reveal="fade">
					More is cooking
				</p>
				<p class="text-zinc-600 text-[15px] leading-relaxed max-w-xl" data-reveal="up" data-reveal-delay="0.06">
					Set up a call and we can talk more!
				</p>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-20 bg-zinc-100 border-t border-zinc-200">
		<div class="max-w-7xl mx-auto px-6 md:px-12 text-center md:text-left">
			<h2 class="font-display text-2xl text-zinc-950 mb-6 tracking-tight" data-reveal="up">Interested in working together?</h2>
			<a
				href="mailto:hello@shironekodigital.com"
				data-reveal="fade"
				data-reveal-delay="0.08"
				class="inline-flex items-center gap-2 font-mono-ui text-xs text-zinc-900 tracking-wide hover:gap-3 transition-all border-b border-zinc-900 pb-0.5"
			>
				Get started on your project
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
					<path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
				</svg>
			</a>
		</div>
	</section>
</Layout>
