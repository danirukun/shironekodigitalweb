---
import Layout from '../components/Layout.astro';
import CapabilityRow from '../components/CapabilityRow.astro';

const offerings: {
	num: string;
	title: string;
	description: string;
	align: 'left' | 'right';
	details: string[];
}[] = [
	{
		num: '01',
		title: 'Web development',
		description:
			'Product sites, marketing surfaces, and internal tools—typed, tested, and fast enough that your creators never wait on the CMS.',
		align: 'left',
		details: [
			'Full-stack web applications (React, Svelte, Astro, Node)',
			'Marketing and product sites with sensible CMS/editor flows',
			'API design, integrations, and performance-conscious delivery',
			'Accessibility and maintainability as defaults, not add-ons',
		],
	},
	{
		num: '02',
		title: 'Platform development',
		description:
			'Live streaming stacks, admin panels, entitlement and moderation, ingest and egress, and hardware glue—built for peak concurrents.',
		align: 'right',
		details: [
			'Realtime admin, moderation, and role-based operations',
			'Ingest/outgest paths, entitlement, and reliability under spike load',
			'Integrations with capture hardware, encoders, and venue constraints',
			'Operational UX so your team isn’t guessing when the room goes loud',
		],
	},
	{
		num: '03',
		title: 'AR / XR development',
		description:
			"Spatial prototypes and shipped layers—tracking, occlusion, and performance budgets that still work when the room is messy and the Wi-Fi isn't.",
		align: 'left',
		details: [
			'Tracking-aware experiences with honest frame budgets',
			'Occlusion, calibration, and failure modes you can rehearse',
			'Shipped layers for shows—not demo-only prototypes locked to one room',
		],
	},
	{
		num: '04',
		title: 'AV consultation · VTuber · live streaming',
		description:
			'Signal paths, lighting discipline, talent UX, and the small ergonomics that keep a marathon stream human.',
		align: 'right',
		details: [
			'Signal path, lighting, and audio discipline for long sessions',
			'Talent-side ergonomics: scenes, guardrails, fewer wrong clicks',
			'Support for OBS-class workflows and broadcast-adjacent toolchains',
		],
	},
	{
		num: '05',
		title: 'Project management',
		description:
			'Roadmaps that respect dependencies: firmware, venues, approvals, and the one vendor who only replies on Mondays.',
		align: 'left',
		details: [
			'Cut plans that name dependencies before they bite at go-live',
			'Vendor, venue, and compliance timing folded into the schedule',
			'Clear ownership when hardware, software, and talent all move at once',
		],
	},
	{
		num: '06',
		title: 'Creator & VTuber tools',
		description:
			'Custom panels, overlays, asset helpers, and workflow glue—opinionated around streaming ergonomics, not generic dashboards.',
		align: 'right',
		details: [
			'Panels, overlays, and triggers tuned to how talent actually streams',
			'Asset and scene helpers that reduce cognitive load mid-show',
			'Small utilities that remove friction without rebuilding your whole stack',
		],
	},
];
---

<Layout
	title="Services"
	description="Web, platforms, AR/XR, AV and VTuber workflows, project management, and creator tools—how Shironeko Digital helps teams ship live."
>
	<section class="pt-24 md:pt-28 pb-12 md:pb-16 bg-zinc-100 border-b border-zinc-200">
		<div class="max-w-7xl mx-auto px-6 md:px-12">
			<div class="max-w-3xl space-y-5">
				<p class="font-mono-ui text-[11px] text-zinc-500 tracking-[0.28em] uppercase" data-reveal="fade">Services</p>
				<h1
					class="font-display text-4xl md:text-[2.75rem] text-zinc-950 leading-[1.05] tracking-tight"
					data-reveal="up"
					data-reveal-delay="0.06"
				>
					What we build—and how deep we go.
				</h1>
				<p class="text-zinc-600 text-[15px] md:text-base leading-relaxed" data-reveal="up" data-reveal-delay="0.12">
					The same capability map as our homepage, with a bit more texture. If it touches go-live, latency, or talent
					ergonomics, we care about the boring parts so the show doesn’t have to.
				</p>
			</div>
		</div>
	</section>

	<section class="bg-white">
		<div class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-20">
			<div class="flex flex-row justify-between items-end gap-8 pb-8 md:pb-12 border-b border-zinc-200">
				<div class="space-y-3 min-w-0">
					<p class="font-mono-ui text-[11px] text-zinc-500 tracking-[0.28em] uppercase" data-reveal="fade">Offerings</p>
					<h2 class="font-display text-3xl md:text-[34px] text-zinc-950 tracking-tight" data-reveal="up" data-reveal-delay="0.06">
						Capabilities in detail
					</h2>
				</div>
				<div class="hidden sm:block w-px h-24 bg-zinc-200 shrink-0" aria-hidden="true"></div>
			</div>
			<div class="pt-2">
				{offerings.map((row, i) => <CapabilityRow {...row} revealIndex={i} />)}
			</div>
		</div>
	</section>

	<section class="bg-zinc-100 border-t border-zinc-200">
		<div class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-20">
			<div class="flex flex-col md:flex-row md:justify-between md:items-start gap-10">
				<div class="space-y-4 max-w-xl">
					<p class="font-mono-ui text-[11px] text-zinc-500 tracking-[0.28em] uppercase" data-reveal="fade">Next step</p>
					<p class="text-zinc-950 text-xl md:text-[22px] leading-snug font-medium" data-reveal="up" data-reveal-delay="0.06">
						Send a messy brief. We’ll reply with a concrete cut plan.
					</p>
				</div>
				<div class="flex flex-col gap-3 shrink-0">
					<div class="w-30 h-px bg-zinc-300" data-reveal="fade" data-reveal-delay="0.1" aria-hidden="true"></div>
					<a
						href="mailto:hello@shironekodigital.com"
						class="font-mono-ui text-xs text-zinc-900 hover:underline underline-offset-4"
						data-reveal="left"
						data-reveal-delay="0.16"
						>hello@shironekodigital.com</a
					>
				</div>
			</div>
		</div>
	</section>
</Layout>
