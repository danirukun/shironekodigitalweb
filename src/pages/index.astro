---
import Layout from '../components/Layout.astro';
import CapabilityRow from '../components/CapabilityRow.astro';

const capabilities: { num: string; title: string; description: string; align: 'left' | 'right' }[] = [
	{
		num: '01',
		title: 'Web development',
		description:
			'Product and marketing websites, internal tools, custom solutions. We do it all, in the most elegant way possible.',
		align: 'left',
	},
	{
		num: '02',
		title: 'Platform development',
		description:
			'Live streaming stacks, admin panels, entitlement and moderation, ingest and egress, and hardware glue—built for peak concurrents.',
		align: 'right',
	},
	{
		num: '04',
		title: 'AV consulting',
		description:
			'Everything from using OBS, to building your own AV setup and streaming stack.',
		align: 'left',
	},
	{
		num: '06',
		title: 'Creator & VTuber tools',
		description:
			'Custom panels, overlays, asset helpers, and other things that add some extra flair to your stream.',
		align: 'right',
	},
];
---

<Layout
	title="Software for creators, streams, and spatial layers"
	description="Shironeko Digital builds web, platforms, AR/XR, and creator-side tools for VTubers, broadcast teams, and everyone who ships live."
>
	<!-- Hero: background image at /images/hero.jpg (sourced from Unsplash for the prototype). -->
	<section class="relative min-h-[72vh] overflow-hidden">
		<img
			src="/images/hero.jpg"
			alt=""
			class="absolute inset-0 size-full object-cover object-center"
			width="1920"
			height="1080"
			fetchpriority="high"
		/>
		<div
			class="absolute inset-0 bg-linear-to-t from-zinc-50 via-zinc-50/80 to-zinc-50/25"
			aria-hidden="true"
		></div>
		<div class="relative max-w-7xl mx-auto px-6 md:px-12 min-h-[72vh] flex flex-col justify-end pb-14 md:pb-20 pt-28">
			<div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-10 lg:gap-16 w-full max-w-6xl">
				<div class="space-y-4 md:space-y-5 lg:max-w-3xl">
					<p class="font-mono-ui text-xs text-zinc-600 tracking-[0.12em]" data-reveal="fade" data-reveal-delay="0" data-reveal-start="top 95%">
						Consulting - RnD - Creators
					</p>
					<h1
						class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-[4.25rem] text-zinc-950 leading-[1.1] tracking-tight"
						data-reveal="up"
						data-reveal-delay="0.08"
						data-reveal-start="top 95%"
						data-reveal-duration="0.95"
					>
						Delivering perfection at every level.
					</h1>
				</div>
				<div class="flex flex-col gap-5 lg:w-100 shrink-0 lg:pb-1">
					<p class="text-zinc-600 text-[15px] leading-relaxed" data-reveal="left" data-reveal-delay="0.18" data-reveal-start="top 95%">
						Creating software that people love. Utilities, platforms, and other custom solutions.
					</p>
					<div class="w-24 h-px bg-zinc-300" data-reveal="fade" data-reveal-delay="0.28" data-reveal-start="top 95%" aria-hidden="true"></div>
					<a
						href="mailto:hello@shironekodigital.com?subject=Project%20brief"
						class="font-mono-ui text-[13px] text-zinc-900 tracking-wide hover:underline underline-offset-4 w-fit"
						data-reveal="fade"
						data-reveal-delay="0.35"
						data-reveal-start="top 95%"
					>
						Start with the messy brief →
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-zinc-100 border-y border-zinc-200">
		<div class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-20">
			<div class="flex flex-col md:flex-row gap-12 md:gap-14 items-start">
				<div class="shrink-0 space-y-5 w-full md:w-55">
					<p class="font-mono-ui text-[11px] text-zinc-500 tracking-[0.28em] uppercase" data-reveal="right" data-reveal-duration="0.75">
						How we work
					</p>
					<p
						class="font-display text-[5rem] md:text-[6rem] leading-[0.75] text-zinc-200 select-none"
						data-reveal="fade"
						data-reveal-delay="0.1"
						data-reveal-duration="1"
						aria-hidden="true"
					>
						—
					</p>
				</div>
				<div class="min-w-0 space-y-5 md:pt-1">
					<h2
						class="font-display text-3xl md:text-[44px] text-zinc-950 leading-[1.06] tracking-tight max-w-4xl"
						data-reveal="up"
						data-reveal-delay="0.06"
					>
						Make the fragile parts boring.
					</h2>
					<p class="text-zinc-600 text-[15px] leading-[1.55] max-w-xl" data-reveal="up" data-reveal-delay="0.14">
						Let us worry about the hard stuff, so you can focus on what matters most.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-white">
		<div class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-20">
			<div class="flex flex-row justify-between items-end gap-8 pb-8 md:pb-12 border-b border-zinc-200">
				<div class="space-y-3 min-w-0">
					<p class="font-mono-ui text-[11px] text-zinc-500 tracking-[0.28em] uppercase" data-reveal="fade">
						Capabilities
					</p>
					<h2 class="font-display text-3xl md:text-[34px] text-zinc-950 tracking-tight" data-reveal="up" data-reveal-delay="0.08">
						What we actually do
					</h2>
				</div>
				<div class="hidden sm:block w-px h-24 bg-zinc-200 shrink-0" aria-hidden="true"></div>
			</div>
			<div class="pt-2">
				{capabilities.map((c, i) => <CapabilityRow {...c} revealIndex={i} />)}
			</div>
		</div>
	</section>

	<section class="bg-zinc-100 border-t border-zinc-200">
		<div class="max-w-7xl mx-auto px-6 md:px-12 py-16 md:py-20">
			<div class="flex flex-col md:flex-row md:justify-between md:items-start gap-10">
				<div class="space-y-4 max-w-xl">
					<p class="font-mono-ui text-[11px] text-zinc-500 tracking-[0.28em] uppercase" data-reveal="fade">
						Next step
					</p>
					<p class="text-zinc-950 text-xl md:text-[22px] leading-snug font-medium" data-reveal="up" data-reveal-delay="0.06">
						Send a messy brief. We’ll reply with a concrete cut plan.
					</p>
				</div>
				<div class="flex flex-col gap-3 md:items-start shrink-0">
					<div class="w-30 h-px bg-zinc-300" data-reveal="fade" data-reveal-delay="0.12" aria-hidden="true"></div>
					<a
						href="mailto:hello@shironekodigital.com"
						class="font-mono-ui text-xs text-zinc-900 hover:underline underline-offset-4"
						data-reveal="left"
						data-reveal-delay="0.18"
						>hello@shironekodigital.com</a
					>
				</div>
			</div>
		</div>
	</section>
</Layout>
