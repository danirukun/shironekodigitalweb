---
import Layout from '../components/Layout.astro';
---

<Layout
	title="Impressum"
	description="Legal disclosure and provider information for Shironeko Digital OÜ (Estonia)."
>
	<section class="pt-32 pb-24 bg-gray-50/50">
		<div class="max-w-6xl mx-auto px-6">
			<div class="max-w-3xl">
				<h1 class="text-5xl font-bold tracking-tight text-gray-900 mb-6 leading-tight">
					Impressum <span class="text-gray-400">(Legal disclosure).</span>
				</h1>
				<p class="text-xl text-gray-500 leading-relaxed">
					Mandatory legal information for services directed at customers in the European Union.
				</p>
			</div>
		</div>
	</section>

	<section class="py-24 bg-white">
		<div class="max-w-6xl mx-auto px-6">
			<div class="max-w-3xl space-y-10">
				<div>
					<h2 class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">Service provider</h2>
					<p class="text-lg font-bold text-gray-900">Shironeko Digital OÜ</p>
					<p class="text-gray-500 leading-relaxed mt-2">
						Sepapaja tn 6<br />
						15551 Tallinn<br />
						Estonia
					</p>
				</div>

				<div>
					<h2 class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">Registry</h2>
					<p class="text-gray-500">
						Registry code: <span class="text-gray-900 font-semibold">17395577</span>
					</p>
					<p class="text-gray-500 mt-2">Registered in Estonia.</p>
				</div>

				<div>
					<h2 class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">Contact</h2>
					<p class="text-gray-500">
						Email:{' '}
						<a href="mailto:hello@shironekodigital.com" class="text-gray-900 font-semibold hover:underline">
							hello@shironekodigital.com
						</a>
					</p>
					<p class="text-gray-500 mt-2">
						Website:{' '}
						<a href="https://shironekodigital.com" class="text-gray-900 font-semibold hover:underline">
							shironekodigital.com
						</a>
					</p>
				</div>

				<div>
					<h2 class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-4">Disclaimer</h2>
					<p class="text-gray-500 leading-relaxed">
						Content on this website is for general information. We strive for accuracy but do not guarantee
						completeness; liability for linked third-party sites lies with their operators. For our full terms,
						see the legal disclaimer on our <a href="/company" class="text-gray-900 font-medium hover:underline">Company</a> page.
					</p>
				</div>
			</div>
		</div>
	</section>
</Layout>
