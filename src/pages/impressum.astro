---
import Layout from '../components/Layout.astro';
---

<Layout
	title="Impressum"
	description="Legal disclosure and provider information for Shironeko Digital OÜ (Estonia)."
>
	<section class="pt-24 md:pt-28 pb-12 md:pb-16 bg-zinc-100 border-b border-zinc-200">
		<div class="max-w-7xl mx-auto px-6 md:px-12">
			<div class="max-w-3xl">
				<h1 class="font-display text-4xl md:text-5xl text-zinc-950 mb-5 leading-tight tracking-tight">
					Impressum (Legal disclosure).
				</h1>
				<p class="text-lg text-zinc-600 leading-relaxed">
					Mandatory legal information for services directed at customers in the European Union.
				</p>
			</div>
		</div>
	</section>

	<section class="py-16 md:py-24 bg-white">
		<div class="max-w-7xl mx-auto px-6 md:px-12">
			<div class="max-w-3xl space-y-10">
				<div>
					<h2 class="font-mono-ui text-[10px] tracking-[0.25em] uppercase text-zinc-500 mb-4">Service provider</h2>
					<p class="text-lg font-medium text-zinc-900">Shironeko Digital OÜ</p>
					<p class="text-zinc-600 leading-relaxed mt-2 text-[15px]">
						Sepapaja tn 6<br />
						15551 Tallinn<br />
						Estonia
					</p>
				</div>

				<div>
					<h2 class="font-mono-ui text-[10px] tracking-[0.25em] uppercase text-zinc-500 mb-4">Registry</h2>
					<p class="text-zinc-600 text-[15px]">
						Registry code: <span class="text-zinc-900 font-semibold">17395577</span>
					</p>
					<p class="text-zinc-600 mt-2 text-[15px]">Registered in Estonia.</p>
				</div>

				<div>
					<h2 class="font-mono-ui text-[10px] tracking-[0.25em] uppercase text-zinc-500 mb-4">Contact</h2>
					<p class="text-zinc-600 text-[15px]">
						Email:{' '}
						<a href="mailto:hello@shironekodigital.com" class="text-zinc-900 font-semibold hover:underline">
							hello@shironekodigital.com
						</a>
					</p>
					<p class="text-zinc-600 mt-2 text-[15px]">
						Website:{' '}
						<a href="https://shironekodigital.com" class="text-zinc-900 font-semibold hover:underline">
							shironekodigital.com
						</a>
					</p>
				</div>

				<div>
					<h2 class="font-mono-ui text-[10px] tracking-[0.25em] uppercase text-zinc-500 mb-4">Disclaimer</h2>
					<p class="text-zinc-600 leading-relaxed text-[15px]">
						Content on this website is for general information. We strive for accuracy but do not guarantee completeness;
						liability for linked third-party sites lies with their operators. For our full terms, see the legal
						disclaimer on our <a href="/company" class="text-zinc-900 font-medium hover:underline">Company</a> page.
					</p>
				</div>
			</div>
		</div>
	</section>
</Layout>
